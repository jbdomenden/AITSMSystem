{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "AITSM: Run server",
      "type": "shell",
      "command": ".\\gradlew.bat run",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "AITSM: Test",
      "type": "shell",
      "command": ".\\gradlew.bat test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": "test",
      "problemMatcher": []
    }
  ]
}
